@{
    ViewData["Title"] = "Create Exercise";
}

<h1>Create Exercise</h1>

<form method="post" asp-controller="Exercises" asp-action="Create">
    <div class="form-group mb-3">
        <label for="exercise-name">Exercise Name</label>
        <input type="text" class="form-control" id="exercise-name" name="name" value="@ViewBag.ExerciseName" />
    </div>

    <div class="form-group mb-3">
        <label for="muscle">Muscle Group</label>
        <select class="form-control" id="muscle" name="muscle">
            <option value="">Select muscle group</option>
            <option value="Chest" selected="@((string?)ViewBag.MuscleGroup == "Chest")">Chest</option>
            <option value="Back" selected="@((string?)ViewBag.MuscleGroup == "Back")">Back</option>
            <option value="Shoulders" selected="@((string?)ViewBag.MuscleGroup == "Shoulders")">Shoulders</option>
            <option value="Biceps" selected="@((string?)ViewBag.MuscleGroup == "Biceps")">Biceps</option>
            <option value="Triceps" selected="@((string?)ViewBag.MuscleGroup == "Triceps")">Triceps</option>
            <option value="Legs" selected="@((string?)ViewBag.MuscleGroup == "Legs")">Legs</option>
            <option value="Abs" selected="@((string?)ViewBag.MuscleGroup == "Abs")">Abs</option>
        </select>
    </div>

    <div class="form-group mb-3">
        <label for="difficulty">Difficulty</label>
        <select class="form-control" id="difficulty" name="difficulty">
            <option value="">Select difficulty</option>
            <option value="Beginner" selected="@((string?)ViewBag.Difficulty == "Beginner")">Beginner</option>
            <option value="Intermediate" selected="@((string?)ViewBag.Difficulty == "Intermediate")">Intermediate</option>
            <option value="Advanced" selected="@((string?)ViewBag.Difficulty == "Advanced")">Advanced</option>
        </select>
    </div>

    <div class="form-group mb-3">
        <label for="recommended-reps">Recommended Reps</label>
        <input type="number" min="1" class="form-control" id="recommended-reps" name="reps" value="@ViewBag.RecommendedReps" />
    </div>

    <div class="form-group mb-3">
        <label for="description">Description</label>
        <textarea class="form-control" id="description" name="description">@ViewBag.Description</textarea>
    </div>

    <button type="submit" class="btn btn-primary">Create</button>
    <p class="text-danger mt-3">@ViewBag.Message</p>
</form>

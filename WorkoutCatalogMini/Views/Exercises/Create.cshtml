@{
    ViewData["Title"] = "Create";
}

<form method="post" action="/exercises/create">
    <div class="form-group">
        <label for="exercise-name">Exercise Name</label>
        <input type="text" class="form-control" id="exercise-name" name="ExerciseName" value="@ViewBag.ExerciseName">
    </div>

    <div class="form-group">
        <label for="muscle-group">Muscle Group</label>
        <select class="form-control" id="muscle-group" name="MuscleGroup">
            @foreach (var muscleGroup in Enum.GetValues(typeof(MuscleGroup)))
            {
                if (muscleGroup.ToString() == ViewBag.MuscleGroup)
                {
                    <option value="@muscleGroup" selected>@muscleGroup</option>
                }
                else
                {
                    <option value="@muscleGroup">@muscleGroup</option>
                }
            }
        </select>
    </div>

    <div class="form-group">
        <label for="difficulty">Difficulty</label>
        <select class="form-control" id="difficulty" name="Difficulty">
            @foreach (var difficulty in Enum.GetValues(typeof(Difficulty)))
            {
                if (difficulty.ToString() == ViewBag.Difficulty)
                {
                    <option value="@difficulty" selected>@difficulty</option>
                }
                else
                {
                    <option value="@difficulty">@difficulty</option>
                }
            }
        </select>
    </div>

    <div class="form-group">
        <label for="recommended-reps">Recommended Reps</label>
        <input type="number" class="form-control" id="recommended-reps" name="RecommendedReps">
    </div>

    <div class="form-group">
        <label for="description">Description</label>
        <input type="text" class="form-control" id="description" name="Description" value="@ViewBag.Description">
    </div>
    <br />
    <button type="submit" class="btn btn-primary">Create</button>
    <label style="color: red;">
        @ViewBag.Message
    </label>
</form>
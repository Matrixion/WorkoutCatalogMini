<form method="post" action="/exercises/create">
    <div class="form-group">
        <label for="exercise-name">Exercise Name</label>
        <input type="text" class="form-control" id="exercise-name" name="Name">
    </div>

    <div class="form-group">
        <label for="muscle-group">Muscle Group</label>
        <input type="text" class="form-control" id="muscle-group" name="MuscleGroup">
    </div>

    <div class="form-group">
        <label for="difficulty">Difficulty</label>
        <select class="form-control" id="difficulty" name="Difficulty">
            <option value="beginner">Beginner</option>
            <option value="intermediate">Intermediate</option>
            <option value="advanced">Advanced</option>
        </select>
    </div>

    <div class="form-group">
        <label for="recommended-reps">Recommended Reps</label>
        <input type="number" class="form-control" id="recommended-reps" name="RecommendedReps">
    </div>

    <div class="form-group">
        <label for="description">Description</label>
        <input type="text" class="form-control" id="description" name="Description">
    </div>

    <button type="submit" class="btn btn-primary">Create</button>
</form>